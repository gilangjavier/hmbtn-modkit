index 751c770..54b1509 100644
--- a/cmake/program.ld.in
+++ b/cmake/program.ld.in
@@ -13,3 +13,13 @@ SECTIONS
 {
 @PSX_SECTIONS@/DISCARD/ : { *(*); }
 }
+
+/* The RAM budget. Above FARM's image the farm keeps a sector-aligned window of
+ * FARM_IMAGE_SIZE (0x49000) bytes, then its section buffer, which must end below the
+ * frame work region at 0x801BE1B0 (main.c WORK_REGION) for the largest farm section
+ * (0x39800 bytes, section 22). Code a mod adds to the EXE or to FARM moves all of it up:
+ * the retail game leaves 0xDB90 bytes. What is left over is where event scripts load in
+ * the background (main_region_free_bytes); less of it only makes more of them load in
+ * the foreground. */
+ASSERT(overlay_low + ALIGN(overlay_high - overlay_low, 0x800) + 0x49000 + 0x39800 <= 0x801BE1B0,
+       "the EXE and FARM are too big: the largest farm section would overrun the work region at 0x801BE1B0")
diff --git a/modkit/hm.h b/modkit/hm.h
new file mode 100644
index 0000000..6e1bf9e
--- /dev/null
+++ b/modkit/hm.h
@@ -0,0 +1,47 @@
+#ifndef HM_H
+#define HM_H
+
+/* The mod API: what a mod's C file includes. It pulls in the game's state and input,
+ * and adds a few helpers. Every header of the decomp is on the include path too, so a mod
+ * can include any of them (farm_state.h, player.h, items.h, event_flags.h, ...).
+ *
+ * The game's whole save state is `game_state` (src/main/game/farm_state.h); the player
+ * is game_state.player (src/overlay/11_GF_FARM/people/player.h). Code a mod links lives
+ * in the EXE and is always resident, but functions of an overlay (FARM, a minigame)
+ * exist only while that overlay is loaded: call one only from a hook that runs there
+ * (minute, new_day) or after checking hm_in_farm(). */
+
+#include "types.h"
+#include "main.h"
+#include "pad.h"
+#include "farm_state.h"
+
+/* The buttons of controller 1 (PAD_* in pad.h): held now, or pressed this frame. */
+#define hm_pad_held(buttons)    ((input_pad1->held & (buttons)) == (buttons))
+#define hm_pad_pressed(buttons) (hm_pad_held(buttons) && (input_pad1->pressed & (buttons)))
+
+/* The player and the date. */
+#define hm_player       (game_state.player)
+#define hm_date         (game_state.progress.clock.date)
+#define hm_time         (game_state.progress.clock.time.hm)
+
+/* The scene the main loop runs (SCENE_* in main.h). */
+extern s32 main_scene;
+#define hm_in_farm()    (main_scene == SCENE_FARM || main_scene == SCENE_FARM_MINIGAME_EXIT \
+                         || main_scene == SCENE_FARM_LOADED || main_scene == SCENE_FARM_SAVED \
+                         || main_scene == SCENE_FARM_MENU_RETURN || main_scene == SCENE_FARM_STAFF_EXIT)
+
+/* Add `amount` gold (negative to take), held to 0..9999999 as the game holds it. */
+#define HM_GOLD_MAX 9999999
+static void hm_gold_add(s32 amount) {
+    s32 gold = game_state.player.gold + amount;
+    if (gold > HM_GOLD_MAX) {
+        gold = HM_GOLD_MAX;
+    }
+    if (gold < 0) {
+        gold = 0;
+    }
+    game_state.player.gold = gold;
+}
+
+#endif
