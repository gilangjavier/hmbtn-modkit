diff --git a/cmake/mods.cmake b/cmake/mods.cmake
new file mode 100644
index 0000000..91c5723
--- /dev/null
+++ b/cmake/mods.cmake
@@ -0,0 +1,127 @@
+# Mods: C code linked into the EXE, hooks into the game, and replaced game data.
+#
+#   cmake -S . -B build -DHMBTN_MODS="cheat_pad;daily_allowance" ...
+#
+# Each mod is a directory mods/<id>/ with a manifest, mod.json:
+#
+#   {
+#     "id": "cheat_pad",
+#     "sources": ["cheat_pad.c"],
+#     "hooks": { "frame": "cheat_pad_frame" },
+#     ...                                     (name, version, authors: read by the tools)
+#   }
+#
+# The sources are compiled like the EXE's own (every header of the game is on the include
+# path, and modkit/hm.h is the mod API) and linked into the EXE after the game's code, so
+# they are always resident. "hooks" names the mod's function for each hook it wants
+# (src/main/mods.h). A mod can also hold:
+#
+#   mods/<id>/afile/<member file>   replaces that A_FILE member (disc/a_file.txt names)
+#   mods/<id>/disc/<disc path>      replaces that file of the disc
+#   mods/<id>/patches/*.patch       diffs against the decomp, applied before the build
+#                                   (by the mod tools, not here)
+#
+# With no mods the build is the retail one and still matches the original.
+
+set(HM_HOOKS boot frame scene minute new_day)
+set(HM_HOOK_SIGNATURE_boot "void @F@(void)")
+set(HM_HOOK_SIGNATURE_frame "void @F@(void)")
+set(HM_HOOK_SIGNATURE_scene "void @F@(s32 scene, s32 previous)")
+set(HM_HOOK_SIGNATURE_minute "void @F@(void)")
+set(HM_HOOK_SIGNATURE_new_day "void @F@(void)")
+set(HM_HOOK_CALL_scene "(scene, previous)")
+
+if(NOT HMBTN_MODS)
+    return()
+endif()
+
+# _hm_mod_read(<id>)
+#
+# Read mods/<id>/mod.json: append its sources to hm_sources and its hook functions to
+# hm_hook_<hook>.
+function(_hm_mod_read id)
+    set(dir ${CMAKE_SOURCE_DIR}/mods/${id})
+    if(NOT EXISTS ${dir}/mod.json)
+        message(FATAL_ERROR "HMBTN_MODS: mods/${id}/mod.json does not exist")
+    endif()
+    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${dir}/mod.json)
+    file(READ ${dir}/mod.json manifest)
+    string(JSON manifest_id ERROR_VARIABLE error GET "${manifest}" id)
+    if(error OR NOT manifest_id STREQUAL id)
+        message(FATAL_ERROR "mods/${id}/mod.json: \"id\" must be \"${id}\"")
+    endif()
+
+    set(sources ${hm_sources})
+    string(JSON count ERROR_VARIABLE error LENGTH "${manifest}" sources)
+    if(NOT error AND count GREATER 0)
+        math(EXPR last "${count} - 1")
+        foreach(i RANGE ${last})
+            string(JSON source GET "${manifest}" sources ${i})
+            list(APPEND sources mods/${id}/${source})
+        endforeach()
+    endif()
+    set(hm_sources ${sources} PARENT_SCOPE)
+
+    string(JSON count ERROR_VARIABLE error LENGTH "${manifest}" hooks)
+    if(NOT error AND count GREATER 0)
+        math(EXPR last "${count} - 1")
+        foreach(i RANGE ${last})
+            string(JSON hook MEMBER "${manifest}" hooks ${i})
+            string(JSON function GET "${manifest}" hooks ${hook})
+            if(NOT hook IN_LIST HM_HOOKS)
+                message(FATAL_ERROR "mods/${id}/mod.json: no hook \"${hook}\" (the hooks: ${HM_HOOKS})")
+            endif()
+            if(NOT function MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
+                message(FATAL_ERROR "mods/${id}/mod.json: hook ${hook}: \"${function}\" is not a C name")
+            endif()
+            set(functions ${hm_hook_${hook}})
+            list(APPEND functions ${function})
+            set(hm_hook_${hook} ${functions} PARENT_SCOPE)
+        endforeach()
+    endif()
+endfunction()
+
+set(hm_sources)
+foreach(hook IN LISTS HM_HOOKS)
+    set(hm_hook_${hook})
+endforeach()
+set(HMBTN_AFILE_OVERRIDES)
+set(HMBTN_DISC_REPLACE)
+foreach(mod IN LISTS HMBTN_MODS)
+    _hm_mod_read(${mod})
+    set(dir ${CMAKE_SOURCE_DIR}/mods/${mod})
+    if(IS_DIRECTORY ${dir}/afile)
+        list(APPEND HMBTN_AFILE_OVERRIDES ${dir}/afile)
+    endif()
+    file(GLOB_RECURSE disc_files RELATIVE ${dir}/disc ${dir}/disc/*)
+    foreach(file IN LISTS disc_files)
+        list(APPEND HMBTN_DISC_REPLACE ${file}=${dir}/disc/${file})
+    endforeach()
+    message(STATUS "mod: ${mod}")
+endforeach()
+
+# The hook dispatchers, one per hook, calling the mods' functions in mod order.
+set(registry "/* Generated by cmake/mods.cmake for HMBTN_MODS=${HMBTN_MODS}: do not edit. */\n")
+string(APPEND registry "#include \"types.h\"\n#include \"mods.h\"\n\n")
+foreach(hook IN LISTS HM_HOOKS)
+    set(call "()")
+    if(DEFINED HM_HOOK_CALL_${hook})
+        set(call ${HM_HOOK_CALL_${hook}})
+    endif()
+    foreach(F IN LISTS hm_hook_${hook})
+        string(CONFIGURE "${HM_HOOK_SIGNATURE_${hook}}" prototype @ONLY)
+        string(APPEND registry "${prototype};\n")
+    endforeach()
+    set(F mods_${hook})
+    string(CONFIGURE "${HM_HOOK_SIGNATURE_${hook}}" definition @ONLY)
+    string(APPEND registry "${definition} {\n")
+    foreach(F IN LISTS hm_hook_${hook})
+        string(APPEND registry "    ${F}${call};\n")
+    endforeach()
+    string(APPEND registry "}\n\n")
+endforeach()
+set(registry_file ${CMAKE_SOURCE_DIR}/mods/_registry.c)
+file(CONFIGURE OUTPUT ${registry_file} CONTENT "${registry}" @ONLY)
+
+psx_c_objects(hm_objects GP 0 OWN_COMMONS SOURCES mods/_registry.c ${hm_sources})
+_psx_add_image(mods "" ${hm_objects})
