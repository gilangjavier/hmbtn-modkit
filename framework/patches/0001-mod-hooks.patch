diff --git a/src/main/mods.h b/src/main/mods.h
new file mode 100644
index 0000000..7d194b6
--- /dev/null
+++ b/src/main/mods.h
@@ -0,0 +1,33 @@
+#ifndef MODS_H
+#define MODS_H
+
+/* The mod hooks: where the game calls into the mods a build links (cmake/mods.cmake).
+ * In a retail build (no HMBTN_MODS) every MODS_* call compiles to nothing, so the game
+ * still matches the original. The dispatchers are generated for each build: each calls
+ * the hooks of every mod that names one, in the order the mods are listed. */
+
+#include "types.h"
+
+#ifdef HMBTN_MODS
+void mods_boot(void);                       /* once, after the game is set up, before the title */
+void mods_frame(void);                      /* every frame, before the scene's frame handler */
+void mods_scene(s32 scene, s32 previous);   /* a scene change is requested */
+void mods_farm_load(void);                  /* the farm has been brought up (a day starts or a save loads) */
+void mods_minute(void);                     /* the farm clock passed a minute */
+void mods_new_day(void);                    /* the farm clock rolled over to a new day (6:00) */
+#define MODS_BOOT()                 mods_boot()
+#define MODS_FRAME()                mods_frame()
+#define MODS_SCENE(scene, previous) mods_scene((scene), (previous))
+#define MODS_FARM_LOAD()            mods_farm_load()
+#define MODS_MINUTE()               mods_minute()
+#define MODS_NEW_DAY()              mods_new_day()
+#else
+#define MODS_BOOT()
+#define MODS_FRAME()
+#define MODS_SCENE(scene, previous)
+#define MODS_FARM_LOAD()
+#define MODS_MINUTE()
+#define MODS_NEW_DAY()
+#endif
+
+#endif
